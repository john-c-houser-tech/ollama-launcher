#!/usr/bin/env python3
"""Helper for the Ollama Launcher bar widget.

Commands (each prints one JSON object on stdout):
  models        Local Ollama models with their cached description and the
                facts that matter for picking one for opencode. Local only:
                never waits on the network.
  descriptions  Fetch missing or week-old descriptions from ollama.com, within
                a fixed time budget, caching each one as it arrives.
  credit        Ollama Cloud credit left, from ollama.com/api/balance.
  launch <model> <directory>
                Open a terminal running opencode on that local model.

Network use, all over HTTPS with timeouts and size limits:
  - ollama.com/api/balance with the API key in
    ~/.config/omarchy/ollama-usage/api.key. Answers and failures are cached
    under a lock, so bars on several monitors share one request and a rate
    limit (429) is waited out, not hammered.
  - ollama.com/library/<name> page description, at most once a week per
    model family. A local model with no parent model is looked up under its
    own name.
Everything else talks to the local Ollama at 127.0.0.1:11434.
"""

from __future__ import annotations

import datetime as dt
import fcntl
import html
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import unicodedata
import urllib.error
import urllib.request
from pathlib import Path

OLLAMA = "http://127.0.0.1:11434"
BALANCE_URL = "https://ollama.com/api/balance"
SITE = "https://ollama.com/"
USER_AGENT = "omarchy-ollama-launcher"
KEY_FILE = Path(os.environ.get("OLLAMA_LAUNCHER_KEY_FILE") or Path.home() / ".config/omarchy/ollama-usage/api.key")
CACHE_DIR = Path(os.environ.get("OLLAMA_LAUNCHER_CACHE") or Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "omarchy/ollama-launcher")
LOCAL_TIMEOUT = 5
REMOTE_TIMEOUT = 8
MAX_BYTES = 1 << 20
MAX_MODELS = 100
CREDIT_FRESH_SEC = 60
CREDIT_ERROR_BACKOFF_SEC = 120
CREDIT_AUTH_BACKOFF_SEC = 900
CREDIT_MAX_BACKOFF_SEC = 3600
DESCRIPTION_TTL_SEC = 7 * 86400
DESCRIPTION_RETRY_SEC = 86400
# Hard wall-clock cap on the descriptions command, DNS included: the socket
# timeout bounds each read, not a whole slow-drip request or a name lookup.
DESCRIPTIONS_BUDGET_SEC = 12
MAX_DESCRIPTION = 280
# Measured on this machine (Ollama 0.40.7): a model without num_ctx loads with
# 4096 tokens unless the server sets OLLAMA_CONTEXT_LENGTH.
OLLAMA_DEFAULT_CONTEXT = 4096
# opencode's system prompt and tool definitions alone run to many thousands of
# tokens; below this the start of a conversation can be cut off silently.
MIN_OPENCODE_CONTEXT = 16384
OPENCODE_PROVIDER = "ollama"

MODEL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._\-/]{0,150}(:[A-Za-z0-9._\-]{1,80})?$")
LIBRARY_NAME = re.compile(r"^[a-z0-9][a-z0-9._\-]{0,80}(/[a-z0-9][a-z0-9._\-]{0,80})?$")
META_DESCRIPTION = re.compile(r'<meta\s+name="description"\s+content="([^"]{1,2000})"', re.IGNORECASE)


class Budget(Exception):
  pass


# ---------- small utilities ----------

def now() -> dt.datetime:
  return dt.datetime.now(dt.timezone.utc)


def stamp(at: dt.datetime | None = None) -> str:
  return (at or now()).isoformat(timespec="seconds")


def parse_time(value) -> dt.datetime | None:
  try:
    parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
  except ValueError:
    return None
  return parsed if parsed.tzinfo else None


def age_sec(value) -> float:
  """Seconds since a stored time; a missing or future time counts as never,
  so a clock that was wrong when the cache was written can't freeze it."""
  parsed = parse_time(value)
  if not parsed:
    return float("inf")
  age = (now() - parsed).total_seconds()
  return age if age >= 0 else float("inf")


class NoRedirect(urllib.request.HTTPRedirectHandler):
  def redirect_request(self, req, fp, code, msg, headers, newurl):
    return None  # urllib then raises HTTPError for the 3xx


_no_redirect = urllib.request.build_opener(NoRedirect)


def read_limited(response) -> bytes:
  raw = response.read(MAX_BYTES + 1)
  if len(raw) > MAX_BYTES:
    raise ValueError("response too large")
  return raw


def fetch_json(url: str, timeout: float, body: dict | None = None, key: str = "") -> dict:
  data = json.dumps(body).encode() if body is not None else None
  request = urllib.request.Request(url, data=data, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
  if data is not None:
    request.add_header("Content-Type", "application/json")
  opener = urllib.request.urlopen
  if key:
    # The key must never follow a redirect to another host.
    request.add_unredirected_header("Authorization", f"Bearer {key}")
    opener = _no_redirect.open
  with opener(request, timeout=timeout) as response:
    if key and not response.geturl().startswith(SITE):
      raise ValueError("unexpected host")
    payload = json.loads(read_limited(response))
  if not isinstance(payload, dict):
    raise ValueError("unexpected response shape")
  return payload


def fetch_text(url: str, timeout: float) -> str:
  request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "text/html"})
  with urllib.request.urlopen(request, timeout=timeout) as response:
    return response.read(MAX_BYTES).decode("utf-8", "replace")


def read_cache(name: str) -> dict:
  try:
    value = json.loads((CACHE_DIR / name).read_text())
    return value if isinstance(value, dict) else {}
  except (OSError, ValueError):
    return {}


def write_cache(name: str, value: dict) -> None:
  tmp = None
  try:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CACHE_DIR, prefix=f".{name}.")
    with os.fdopen(fd, "w") as handle:
      json.dump(value, handle)
    os.replace(tmp, CACHE_DIR / name)
    tmp = None
  except (OSError, ValueError, TypeError):
    pass  # a cache that can't be written just means fetching again
  finally:
    if tmp:
      try:
        os.unlink(tmp)
      except OSError:
        pass


class Lock:
  """Exclusive lock on a file in the cache folder, so bars on several
  monitors don't each make the same request."""
  def __init__(self, name: str):
    self.name = name
    self.handle = None

  def __enter__(self):
    try:
      CACHE_DIR.mkdir(parents=True, exist_ok=True)
      self.handle = open(CACHE_DIR / self.name, "a")
      fcntl.flock(self.handle, fcntl.LOCK_EX)
    except OSError:
      self.handle = None  # unlocked is still correct, just less shared
    return self

  def __exit__(self, *exc):
    if self.handle:
      self.handle.close()


def clean_text(value, limit: int) -> str:
  """Plain, single-line, length-capped text for display, without control or
  bidirectional-formatting characters that could make it read differently."""
  text = html.unescape(str(value or ""))
  text = "".join(" " if unicodedata.category(ch) in ("Cc", "Zl", "Zp") else ch
                 for ch in text if unicodedata.category(ch) != "Cf")
  text = re.sub(r"\s+", " ", text).strip()
  return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def shq(text: str) -> str:
  return "'" + str(text).replace("'", "'\\''") + "'"


def human_bytes(n) -> str:
  if isinstance(n, bool):
    return ""
  try:
    n = float(n)
  except (TypeError, ValueError):
    return ""
  if n != n or n < 0:
    return ""
  for unit in ("B", "KB", "MB", "GB", "TB"):
    if n < 1000 or unit == "TB":
      return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
    n /= 1000
  return ""


def short_tokens(n: int) -> str:
  return f"{n // 1024}k" if n >= 1024 and n % 1024 == 0 else (f"{n / 1000:.0f}k" if n >= 1000 else str(n))


# ---------- models ----------

def context_setting(text: str) -> int | None:
  match = re.search(r"(?:^|\s|\")OLLAMA_CONTEXT_LENGTH=\"?(\d{3,7})\b", text, re.MULTILINE)
  return int(match.group(1)) if match else None


def server_default_context() -> tuple[int, str]:
  """Context Ollama gives a model with no num_ctx: OLLAMA_CONTEXT_LENGTH from
  the user unit (inline or in an EnvironmentFile), else Ollama's default."""
  try:
    out = subprocess.run(["systemctl", "--user", "show", "ollama", "-p", "Environment", "-p", "EnvironmentFiles"],
                         capture_output=True, text=True, timeout=3).stdout
  except (OSError, subprocess.TimeoutExpired):
    out = ""
  value = None
  for line in out.splitlines():
    if line.startswith("Environment="):
      value = context_setting(line[len("Environment="):]) or value
    elif line.startswith("EnvironmentFiles="):
      path = line[len("EnvironmentFiles="):].split(" (", 1)[0].strip()
      try:
        value = context_setting(Path(path).read_text()[:65536]) or value
      except (OSError, UnicodeDecodeError):
        pass
  if value:
    return value, "server setting"
  return OLLAMA_DEFAULT_CONTEXT, "Ollama default"


def num_ctx_from(parameters) -> int | None:
  match = re.search(r"^\s*num_ctx\s+(\d{2,7})\s*$", str(parameters or ""), re.MULTILINE)
  return int(match.group(1)) if match else None


def weights_blob(modelfile) -> str:
  """The blob a model's weights come from, so copies of one model that differ
  only in settings can be recognized."""
  for line in str(modelfile or "").splitlines():
    match = re.match(r"^FROM\s+\S*(sha256-[0-9a-f]{64})\s*$", line.strip())
    if match:
      return match.group(1)
  return ""


def library_name(name: str, parent: str) -> str:
  """The ollama.com library page a model belongs to: the family before the
  tag, using the parent for a locally derived copy."""
  base = (parent or name).split(":", 1)[0].lower()
  if base.startswith("library/"):
    base = base[len("library/"):]
  return base if LIBRARY_NAME.match(base) else ""


def library_url(family: str) -> str:
  return SITE + ("library/" + family if "/" not in family else family)


def parse_description(page: str) -> str:
  match = META_DESCRIPTION.search(page)
  return clean_text(match.group(1), MAX_DESCRIPTION) if match else ""


def description_entries() -> dict:
  entries = read_cache("library.json").get("entries")
  return entries if isinstance(entries, dict) else {}


def description_due(entry) -> bool:
  entry = entry if isinstance(entry, dict) else {}
  return age_sec(entry.get("checkedAt")) >= (DESCRIPTION_TTL_SEC if entry.get("text") else DESCRIPTION_RETRY_SEC)


def fetch_descriptions(families: list[str]) -> int:
  """Fetch due descriptions one by one, saving each, until the budget runs
  out. Returns how many entries changed."""
  changed = 0

  def out_of_time(signum, frame):
    raise Budget()

  previous = signal.signal(signal.SIGALRM, out_of_time)
  signal.alarm(DESCRIPTIONS_BUDGET_SEC)
  try:
    with Lock(".library.lock"):
      for family in families:
        entries = description_entries()  # re-read: another run may have filled it
        entry = entries.get(family) if isinstance(entries.get(family), dict) else {}
        if not description_due(entry):
          continue
        try:
          text = parse_description(fetch_text(library_url(family), REMOTE_TIMEOUT))
        except (urllib.error.URLError, TimeoutError, OSError, ValueError):
          text = entry.get("text") or ""  # keep the old text through an outage
        entries[family] = {"text": text, "checkedAt": stamp()}
        write_cache("library.json", {"entries": entries})
        changed += 1
  except Budget:
    pass
  finally:
    signal.alarm(0)
    signal.signal(signal.SIGALRM, previous)
  return changed


def advice(model: dict, siblings: list[dict]) -> list[str]:
  notes = []
  if model["context"] < MIN_OPENCODE_CONTEXT:
    better = sorted((s for s in siblings if s["context"] >= MIN_OPENCODE_CONTEXT), key=lambda s: s["context"])
    note = (f"Only {short_tokens(model['context'])} context: opencode's instructions can be cut off "
            "without warning, and the model then looks bad at coding.")
    if better:
      note += f" Use {better[0]['name']} instead (same model, {short_tokens(better[0]['context'])} context)."
    else:
      note += " Make a copy with a larger num_ctx before coding with it."
    notes.append(note)
  if not model["tools"]:
    notes.append("No tool support: opencode can't read files, edit or run commands with it.")
  return notes


def is_cloud(tag: dict, name: str) -> bool:
  tag_part = name.split(":", 1)[1] if ":" in name else ""
  return bool(tag.get("remote_host")) or tag_part == "cloud" or tag_part.endswith("-cloud")


def as_list(value) -> list:
  return value if isinstance(value, list) else []


def list_models() -> dict:
  try:
    tags = fetch_json(f"{OLLAMA}/api/tags", LOCAL_TIMEOUT)
  except (urllib.error.URLError, TimeoutError, OSError, ValueError):
    return {"ok": False, "error": "Ollama isn't answering at 127.0.0.1:11434.", "models": [], "descriptionsDue": False}
  try:
    running = as_list(fetch_json(f"{OLLAMA}/api/ps", LOCAL_TIMEOUT).get("models"))
  except (urllib.error.URLError, TimeoutError, OSError, ValueError):
    running = []
  loaded = {str(m.get("name")): m for m in running if isinstance(m, dict)}
  default_ctx, default_source = server_default_context()

  models = []
  for tag in as_list(tags.get("models"))[:MAX_MODELS]:
    if not isinstance(tag, dict):
      continue
    name = str(tag.get("name") or "")
    if not MODEL_NAME.match(name) or is_cloud(tag, name):
      continue  # local models only
    details = tag.get("details") if isinstance(tag.get("details"), dict) else {}
    try:
      show = fetch_json(f"{OLLAMA}/api/show", LOCAL_TIMEOUT, body={"model": name})
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
      show = {}
    show_details = show.get("details") if isinstance(show.get("details"), dict) else {}
    capabilities = as_list(show.get("capabilities"))
    set_ctx = num_ctx_from(show.get("parameters"))
    run = loaded.get(name) or {}
    run_ctx = run.get("context_length")
    if isinstance(run_ctx, int) and not isinstance(run_ctx, bool) and 0 < run_ctx < 10_000_000:
      context, context_source = run_ctx, "loaded now"
    elif set_ctx:
      context, context_source = set_ctx, "set on the model"
    else:
      context, context_source = default_ctx, default_source
    models.append({
      "name": name,
      "family": library_name(name, str(show_details.get("parent_model") or "")),
      "blob": weights_blob(show.get("modelfile")),
      "parameterSize": clean_text(details.get("parameter_size"), 20),
      "quantization": clean_text(details.get("quantization_level"), 20),
      "size": human_bytes(tag.get("size")),
      "context": context,
      "contextSource": context_source,
      "tools": "tools" in capabilities,
      "loaded": name in loaded,
    })

  entries = description_entries()
  families = sorted({m["family"] for m in models if m["family"]})
  for model in models:
    siblings = [s for s in models if s is not model and s["blob"] and s["blob"] == model["blob"]]
    entry = entries.get(model["family"]) if isinstance(entries.get(model["family"]), dict) else {}
    model["description"] = clean_text(entry.get("text"), MAX_DESCRIPTION)
    facts = [model["parameterSize"], model["quantization"], model["size"],
             f"{short_tokens(model['context'])} context ({model['contextSource']})",
             "tools" if model["tools"] else "no tools"]
    model["facts"] = " · ".join(f for f in facts if f)
    notes = advice(model, siblings)
    # One string, not a list: nested lists reach QML as a sequence type that
    # Array.isArray rejects, which once hid the warning.
    model["warning"] = " ".join(notes)
    model["ready"] = not notes
  for model in models:
    del model["blob"]
  models.sort(key=lambda m: (not m["ready"], m["name"]))  # ready-to-code first
  return {"ok": True, "error": "", "models": models, "families": families,
          "descriptionsDue": any(description_due(entries.get(f)) for f in families)}


def descriptions(families: list[str]) -> dict:
  families = [f for f in families if LIBRARY_NAME.match(f)][:MAX_MODELS]
  return {"ok": True, "changed": fetch_descriptions(families)}


# ---------- credit ----------

def usd(value, signed: bool = False) -> float | None:
  if isinstance(value, bool):
    return None
  try:
    number = float(value)
  except (TypeError, ValueError):
    return None
  low = -1e9 if signed else 0
  return number if number == number and low <= number < 1e9 else None


def parse_balance(payload: dict) -> dict:
  included = payload.get("included") if isinstance(payload.get("included"), dict) else {}
  purchased = payload.get("purchased") if isinstance(payload.get("purchased"), dict) else {}
  allowance = usd(included.get("allowance_usd"))
  left = usd(included.get("balance_usd"), signed=True)
  bought = usd(purchased.get("balance_usd")) or 0.0
  if left is None and not bought:
    raise ValueError("no balance in response")
  period = included.get("period") if isinstance(included.get("period"), dict) else {}
  resets = parse_time(period.get("until")) if period.get("until") else None
  return {
    "includedLeftUsd": left or 0.0,
    "allowanceUsd": allowance or 0.0,
    "purchasedUsd": bought,
    "totalLeftUsd": round((left or 0.0) + bought, 2),
    "resetsAt": stamp(resets) if resets else "",
  }


def retry_after(error: urllib.error.HTTPError) -> int:
  try:
    seconds = int(str(error.headers.get("Retry-After") or "").strip())
  except (ValueError, AttributeError):
    seconds = 0
  return max(CREDIT_ERROR_BACKOFF_SEC, min(seconds, CREDIT_MAX_BACKOFF_SEC))


def credit_view(cache: dict) -> dict:
  good = cache.get("good") if isinstance(cache.get("good"), dict) else None
  error = str(cache.get("error") or "")
  if good:
    return {**good, "ok": True, "stale": bool(error), "error": error}
  return {"ok": False, "stale": False, "error": error or "No reading yet."}


def credit(force: bool = False) -> dict:
  with Lock(".credit.lock"):
    cache = read_cache("credit.json")
    next_try = parse_time(cache.get("nextTryAt"))
    due = (force or next_try is None or next_try <= now()
           or (next_try - now()).total_seconds() > CREDIT_MAX_BACKOFF_SEC)  # clock skew guard
    if not due:
      return credit_view(cache)
    try:
      key = KEY_FILE.read_text().strip()
    except (OSError, UnicodeDecodeError):
      key = ""
    backoff = CREDIT_ERROR_BACKOFF_SEC
    if not key:
      cache["error"], backoff = f"No Ollama API key in {KEY_FILE}.", CREDIT_AUTH_BACKOFF_SEC
    else:
      try:
        cache["good"] = {**parse_balance(fetch_json(BALANCE_URL, REMOTE_TIMEOUT, key=key)), "checkedAt": stamp()}
        cache["error"], backoff = "", CREDIT_FRESH_SEC
      except urllib.error.HTTPError as error:
        if error.code in (401, 403):
          cache["error"], backoff = "ollama.com rejected the API key.", CREDIT_AUTH_BACKOFF_SEC
        elif 300 <= error.code < 400:
          cache["error"] = "ollama.com redirected the balance request; not following it with the key."
        else:
          cache["error"], backoff = f"ollama.com answered HTTP {error.code}.", retry_after(error)
      except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        cache["error"] = "Couldn't read the balance from ollama.com."
    cache["nextTryAt"] = stamp(now() + dt.timedelta(seconds=backoff))
    write_cache("credit.json", cache)
    return credit_view(cache)


# ---------- launch ----------

def launch_config(model: str) -> str:
  selection = {"providerID": OPENCODE_PROVIDER, "model": model}
  # The title agent has its own model in opencode.json (an Anthropic one);
  # pin it too, or the first message of a "local" session leaves the machine.
  return json.dumps({"model": selection, "agents": {"title": {"model": selection}}}, separators=(",", ":"))


def launch_script(model: str, directory: str) -> str:
  # --standalone gives this launch its own server, so the model choice
  # applies; the shared background service ignores per-launch config. The
  # session still lands in opencode's normal session list.
  return "\n".join([
    f"cd -- {shq(directory)} || {{ printf 'Folder not found: %s\\n' {shq(directory)}; read -r _; exit 1; }}",
    f"export OPENCODE_CONFIG_CONTENT={shq(launch_config(model))}",
    "opencode --standalone",
    "status=$?",
    "if [ \"$status\" -ne 0 ]; then printf '\\nopencode exited with status %s. Press Enter to close.' \"$status\"; read -r _; fi",
  ])


def launch(model: str, directory: str) -> dict:
  if not MODEL_NAME.match(model):
    return {"ok": False, "error": "Not a model name."}
  try:
    tags = as_list(fetch_json(f"{OLLAMA}/api/tags", LOCAL_TIMEOUT).get("models"))
  except (urllib.error.URLError, TimeoutError, OSError, ValueError):
    return {"ok": False, "error": "Ollama isn't answering."}
  if model not in {str(m.get("name")) for m in tags if isinstance(m, dict)}:
    return {"ok": False, "error": "That model isn't installed."}
  folder = Path(os.path.expanduser(directory or "~/Projects"))
  if not folder.is_absolute():
    folder = Path.home() / folder
  folder = folder.resolve()
  if not folder.is_dir():
    return {"ok": False, "error": f"Folder not found: {folder}"}
  try:
    subprocess.Popen(
      ["setsid", "uwsm-app", "--", "xdg-terminal-exec", "-e", "bash", "-lc", launch_script(model, str(folder))],
      stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
  except OSError as error:
    return {"ok": False, "error": f"Couldn't open a terminal: {error.strerror or error}"}
  return {"ok": True, "error": ""}


def run(argv: list[str]) -> tuple[dict, int]:
  command = argv[1] if len(argv) > 1 else ""
  if command == "models":
    return list_models(), 0
  if command == "descriptions":
    return descriptions(argv[2:]), 0
  if command == "credit":
    return credit(force="--force" in argv), 0
  if command == "launch" and len(argv) >= 3:
    result = launch(argv[2], argv[3] if len(argv) > 3 else "")
    return result, 0 if result["ok"] else 2
  print(__doc__, file=sys.stderr)
  return {"ok": False, "error": "Unknown command."}, 2


def main(argv: list[str]) -> int:
  try:
    result, code = run(argv)
  except Exception as error:  # always answer with JSON so the panel can say what happened
    result, code = {"ok": False, "error": f"Helper error: {type(error).__name__}"}, 1
  print(json.dumps(result))
  return code


if __name__ == "__main__":
  sys.exit(main(sys.argv))
